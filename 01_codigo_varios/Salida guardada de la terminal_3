# ----------------------------
# lectura 24 canales
# ----------------------------


def read_textile():


    vector = np.zeros(
        24,
        dtype=np.float32
    )



    left_touch = mpr_left.touched()

    right_touch = mpr_right.touched()



    # sensor 0x5A
    # canales 0-11


    for ch in range(12):


        if left_touch & (1 << ch):


            vector[ch] = 1.0



    # sensor 0x5C
    # canales 12-23


    for ch in range(12):


        if right_touch & (1 << ch):


            vector[ch+12] = 1.0



    return vector



# ----------------------------
