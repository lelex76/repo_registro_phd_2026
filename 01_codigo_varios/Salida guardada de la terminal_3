            smooth,
            0,
            1
        )



        active = np.where(
            raw > 0
        )[0]



        # --------------------------------------------------
        # SIN CONTACTO
        # --------------------------------------------------

        if len(active) == 0:


            current_amp = 0.0


            play_synth(
                0,
                0
            )


            time.sleep(0.01)

            continue



        # --------------------------------------------------
        # GESTO ACTIVO
        # --------------------------------------------------


        energy = np.sum(
            latent_input
        )


        amp = np.clip(
            energy / 12.0,
            0.05,
            1.0
        )



        # --------------------------------------------------
        # SOM KOHONEN
        # --------------------------------------------------

        bmu, distance = som.winner(
            latent_input
        )


        som.update(
            latent_input
        )



        # coordenada mapa 6x4

        coord = som.grid[bmu]


        x_latent = coord[0]
        y_latent = coord[1]



        # --------------------------------------------------
        # MAPA LATENTE -> AUDIO
        # --------------------------------------------------

        freq = (
            120
            +
            x_latent * 120
            +
            y_latent * 80
        )



        print(
            "TOUCH",
            active.tolist(),
            "BMU",
            bmu,
            "LATENT",
            round(float(x_latent),2),
            round(float(y_latent),2),
            "FREQ",
            int(freq)
        )



        # --------------------------------------------------
        # SINTESIS
        # --------------------------------------------------

        play_synth(
            freq,
            amp
        )


        time.sleep(
            0.01
        )



