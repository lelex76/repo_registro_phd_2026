    )



    # oscilador principal

    wave = np.sin(

        2 *
        np.pi *
        freq *
        t
        +
        phase

    )



    # actualización fase
    # mantiene continuidad del sonido

    phase += (

        2 *
        np.pi *
        freq *
        BUFFER
        /
        SAMPLE_RATE

    )


    phase %= (

        2 *
        np.pi

    )



    # subarmónico corporal

    sub_wave = np.sin(

        2 *
        np.pi *
        (freq * 0.5)
        *
        t

    )



    # textura microscópica

    noise = (

        np.random.randn(BUFFER)

        *

        0.15

    )



    # mezcla tímbrica

    signal = (

        0.65 * wave

        +

        0.25 * sub_wave

        +

        noise

    )



    # saturación suave

    signal = np.tanh(

        signal

        *

        1.2

    )



    # amplitud

    signal *= amp



    # seguridad

    signal = np.clip(

        signal,

        -1.0,

        1.0

    )



    return (

        signal *

        32767

    ).astype(

        np.int16

    )





