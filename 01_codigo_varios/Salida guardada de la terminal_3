#!/usr/bin/env python3
# -*- coding: utf-8 -*-


import time
import numpy as np


# ==========================================================
# RASPBERRY PI I2C / MPR121
# ==========================================================

import board
import busio
import adafruit_mpr121



# ==========================================================
# AUDIO
# ==========================================================

import pygame
import math
import random



# ==========================================================
# CONFIG AUDIO
# ==========================================================

SAMPLE_RATE = 44100
BUFFER = 512



pygame.mixer.pre_init(
    SAMPLE_RATE,
    -16,
    1,
    BUFFER
)


pygame.init()


pygame.mixer.set_num_channels(
    8
)


audio_channel = pygame.mixer.Channel(0)

# memoria de fase del oscilador

phase = 0
# ==========================================================
# MEMORIA TEXTIL / RESONANCIA
# ==========================================================

gesture_memory = np.zeros(
    24,
    dtype=np.float32
)

DECAY = 0.985
FEEDBACK = 0.35


# ==========================================================
# OSCILADOR DIGITAL
# ==========================================================


def synth_buffer(freq, amp):


    global phase



    t = (
        np.arange(BUFFER)
        /
        SAMPLE_RATE
    )



    wave = np.sin(
        2 *
        np.pi *
        freq *
        t
        +
        phase
    )



    phase += (
        2 *
        np.pi *
        freq *
        BUFFER
        /
        SAMPLE_RATE
    )



    # textura orgánica

    noise = (
        np.random.rand(BUFFER)
        -
        0.5
    )



    signal = (
        0.85 * wave
        +
        0.15 * noise
    )



    signal *= amp



    signal = np.clip(
        signal,
        -1,
        1
    )



    return (
        signal * 32767
    ).astype(
        np.int16
    )





# ==========================================================
# REPRODUCCIÓN SINTÉTICA
# ==========================================================


def play_synth(freq, amp):


    global audio_channel



    amp = float(
        np.clip(
            amp,
            0.0,
            1.0
        )
    )



    if amp < 0.01:


        audio_channel.set_volume(
            0
        )

        return




    data = synth_buffer(
        freq,
        amp
    )



    sound = pygame.mixer.Sound(
        buffer=data
    )



    audio_channel.play(
        sound,
        loops=-1
    )



    audio_channel.set_volume(
        amp
    )





# ==========================================================
# STOP
# ==========================================================


def stop_sound():


    global audio_channel


    audio_channel.set_volume(
        0
    )




