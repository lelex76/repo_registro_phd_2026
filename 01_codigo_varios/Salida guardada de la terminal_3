def read_textile():


    vector = np.zeros(

        24,
        dtype=np.float32

    )


    left_touch = mpr_left.touched()

    right_touch = mpr_right.touched()



    for ch in range(12):


        if left_touch & (1 << ch):

            vector[ch] = 1.0




    for ch in range(12):


        if right_touch & (1 << ch):

            vector[ch+12] = 1.0



    return vector





