    print("TEXTILE MEMORY + RESONANCE")
    print("--------------------------------")


    smooth = np.zeros(

        24,

        dtype=np.float32

    )



    global current_amp
    global gesture_memory



    current_amp = 0.0



    # iniciar campo FX

    play_fx_base()



    while True:



        # --------------------------------------------------
        # LECTURA SENSORIAL
        # --------------------------------------------------


        left_touch = mpr_left.touched()

        right_touch = mpr_right.touched()



        raw_left = np.array(

            [

                (left_touch >> i) & 1

                for i in range(12)

            ],

            dtype=np.float32

        )



        raw_right = np.array(

            [

                (right_touch >> i) & 1

                for i in range(12)

            ],

            dtype=np.float32

        )



        raw = np.concatenate(

            [

                raw_left,

                raw_right

            ]

        )




        # --------------------------------------------------
        # MEMORIA SENSORIAL
        # --------------------------------------------------


        smooth = (

            0.8 * smooth

            +

            0.2 * raw

        )



        latent_input = np.clip(

            smooth,

            0,

            1

        )



        active = np.where(

            raw > 0

        )[0]





        # --------------------------------------------------
        # SIN CONTACTO
        # mantiene resonancia
        # --------------------------------------------------


        if len(active) == 0:



            gesture_memory *= DECAY



            time.sleep(0.01)


            continue





        # --------------------------------------------------
        # MEMORIA TEXTIL
        #
        # gesto -> memoria -> resonancia
        # --------------------------------------------------



        gesture_memory *= DECAY



        gesture_memory += (

            latent_input

        )



        memory_energy = np.sum(

            gesture_memory

        )



        energy = (

            memory_energy

            *

            FEEDBACK

        )



        amp = np.clip(

            (energy / 12.0) ** 2.8,

            0.0,

            1.0

        )






        # --------------------------------------------------
        # SOM KOHONEN
        # --------------------------------------------------


        bmu, distance = som.winner(

            latent_input

        )



        som.update(

            latent_input

        )





        # coordenada mapa 6x4


        coord = som.grid[bmu]



        x_latent = coord[0]

        y_latent = coord[1]






        # --------------------------------------------------
        # LATENT SPACE -> AUDIO
        # --------------------------------------------------


        freq = (

            120

            +

            x_latent * 120

            +

            y_latent * 80

        )






        print(

            "TOUCH",

            active.tolist(),

            "BMU",

            bmu,

            "LATENT",

            round(float(x_latent),2),

            round(float(y_latent),2),

            "MEM",

            round(float(memory_energy),2),

            "FREQ",

            int(freq)

        )






        # --------------------------------------------------
        # SINTESIS TEXTIL
        # --------------------------------------------------


        play_synth(

            freq,

            amp

        )



        time.sleep(

            0.01

        )






