    i2c,
    address=0x5A
)


mpr_right = adafruit_mpr121.MPR121(
    i2c,
    address=0x5C
)


print("--------------------------------")
print("MPR121 TEXTILE READY")
print("LEFT  : 0x5A")
print("RIGHT : 0x5C")
print("--------------------------------")


# ----------------------------
# lectura 24 canales
# ----------------------------


def read_textile():


    vector = np.zeros(
        24,
        dtype=np.float32
    )



    left_touch = mpr_left.touched()

    right_touch = mpr_right.touched()



    # sensor 0x5A
    # canales 0-11


    for ch in range(12):


        if left_touch & (1 << ch):


            vector[ch] = 1.0



    # sensor 0x5C
    # canales 12-23


    for ch in range(12):


        if right_touch & (1 << ch):


            vector[ch+12] = 1.0



    return vector



# ----------------------------
# suavizado temporal
# ----------------------------


touch_memory = np.zeros(
    24,
    dtype=np.float32
)



def smooth_touch(raw):


    global touch_memory


    touch_memory = (

        0.80 * touch_memory

        +

        0.20 * raw

    )


    return touch_memory.copy()

# ============================================================
# BLOQUE 3
#
# SOM KOHONEN
#
# Entrada:
#       vector táctil 24D
#
# Salida:
#       espacio latente 2D
#       mapa 6 x 4
#
# ============================================================



# ==========================================================
# BLOQUE 3
# SOM KOHONEN COMPLETO
# MAPA LATENTE 6 x 4
# INPUT: 24 DIMENSIONES SENSORIALES
# OUTPUT: ESPACIO LATENTE 2D
# ==========================================================


class SOM:


    def __init__(
        self,
        rows=6,
        cols=4,
        input_dim=24
    ):


        self.rows = rows
        self.cols = cols
        self.input_dim = input_dim


        # ------------------------------------------
        # parámetros aprendizaje Kohonen
        # ------------------------------------------

        self.learning_rate = 0.35
        self.radius = 2.5

        self.step = 0



        # ------------------------------------------
        # pesos de neuronas
        # 6 x 4 neuronas
        # cada una con vector de 24 entradas
        # ------------------------------------------

        self.weights = (

            np.random.random(
                (
                    rows,
                    cols,
                    input_dim
                )
            )
            *
            0.1

        ).astype(
            np.float32
        )



        # ------------------------------------------
        # GRID LATENTE 2D
        # ------------------------------------------

        grid = []


        for x in range(rows):

            for y in range(cols):

                grid.append(
                    [
                        x,
                        y
                    ]
                )


        self.grid = np.array(
            grid,
            dtype=np.float32
        )



        print("--------------------------------")
        print("SOM KOHONEN READY")
        print("MAP:")
        print(
            rows,
            "x",
            cols
        )
        print(
            "LATENT SPACE: 24D -> 2D"
        )
        print("--------------------------------")




    # ------------------------------------------------
    # buscar neurona ganadora BMU
    # ------------------------------------------------


    def winner(
        self,
        x
    ):


        distances = np.zeros(
            (
                self.rows,
                self.cols
            ),
            dtype=np.float32
        )



        for i in range(
            self.rows
        ):

            for j in range(
                self.cols
            ):


                distances[i,j] = np.linalg.norm(

                    self.weights[i,j]
                    -
                    x

                )



        idx = np.unravel_index(

            np.argmin(
                distances
            ),

            distances.shape

        )


        bmu = (
            idx[0] *
            self.cols
            +
            idx[1]
        )


        error = distances[idx]


        return (
            bmu,
            float(error)
        )




    # ------------------------------------------------
    # aprendizaje Kohonen
    # ------------------------------------------------


    def update(
        self,
        x
    ):


        bmu, _ = self.winner(
            x
        )



        bx = (
            bmu //
            self.cols
        )

        by = (
            bmu %
            self.cols
        )



        # decaimiento

        lr = (
            self.learning_rate
            *
            np.exp(
                -self.step / 5000
            )
        )


        radius = max(

            0.5,

            self.radius
            *
            np.exp(
                -self.step / 5000
            )

        )



        # actualización vecindad

        for i in range(
            self.rows
        ):

            for j in range(
                self.cols
            ):


                distance_grid = math.sqrt(

                    (i-bx)**2
                    +
                    (j-by)**2

                )



                influence = np.exp(

                    -(
                        distance_grid**2
                    )
                    /
                    (
                        2 *
                        radius *
                        radius
                    )

                )



                self.weights[i,j] += (

                    lr *
                    influence *
                    (
                        x
                        -
                        self.weights[i,j]
                    )

                )



        self.step += 1




# ==========================================================
# CREAR SOM
# ==========================================================


som = SOM()


# ==========================================================
# BLOQUE 4
# MOTOR GENERATIVO + LOOP PRINCIPAL
# ==========================================================


def main():

    print("--------------------------------")
    print("TmaqT LATENT GENERATIVE START")
    print("--------------------------------")


    smooth = np.zeros(
        24,
        dtype=np.float32
    )


    global current_amp
    global gesture_memory

    current_amp = 0.0


    while True:


        # --------------------------------------------------
        # LECTURA MPR121
        # --------------------------------------------------

        left_touch = mpr_left.touched()
        right_touch = mpr_right.touched()


        raw_left = np.array(
            [
                (left_touch >> i) & 1
                for i in range(12)
            ],
            dtype=np.float32
        )


        raw_right = np.array(
            [
                (right_touch >> i) & 1
                for i in range(12)
            ],
            dtype=np.float32
        )


        raw = np.concatenate(
            [
                raw_left,
                raw_right
            ]
        )



        # --------------------------------------------------
        # SUAVIZADO TEMPORAL
        # --------------------------------------------------

        smooth = (
            0.8 * smooth
            +
            0.2 * raw
        )


        latent_input = np.clip(
            smooth,
            0,
            1
        )



        active = np.where(
            raw > 0
        )[0]



        # --------------------------------------------------
        # SIN CONTACTO
        # --------------------------------------------------

        if len(active) == 0:


            current_amp = 0.0


            play_synth(
                0,
                0
            )


            time.sleep(0.01)

            continue



        # --------------------------------------------------
        # GESTO ACTIVO
        # --------------------------------------------------


        energy = np.sum(
            latent_input
        )


        amp = np.clip((energy / 12.0) ** 2.8, 0.0, 1.0)


        # --------------------------------------------------
        # SOM KOHONEN
        # --------------------------------------------------

        bmu, distance = som.winner(
            latent_input
        )


        som.update(
            latent_input
        )



        # coordenada mapa 6x4

        coord = som.grid[bmu]


        x_latent = coord[0]
        y_latent = coord[1]



        # --------------------------------------------------
        # MAPA LATENTE -> AUDIO
        # --------------------------------------------------

        freq = (
            120
            +
            x_latent * 120
            +
            y_latent * 80
        )



        print(
            "TOUCH",
            active.tolist(),
            "BMU",
            bmu,
            "LATENT",
            round(float(x_latent),2),
            round(float(y_latent),2),
            "FREQ",
            int(freq)
        )



        # --------------------------------------------------
        # SINTESIS
        # --------------------------------------------------

        play_synth(
            freq,
            amp
        )


        time.sleep(
            0.01
        )



# ==========================================================
# START
# ==========================================================

if __name__ == "__main__":

    main()
