touch_memory = np.zeros(
    24,
    dtype=np.float32
)



def smooth_touch(raw):


    global touch_memory


    touch_memory = (

        0.80 * touch_memory

        +

        0.20 * raw

    )


    return touch_memory.copy()

# ============================================================
# BLOQUE 3
#
# SOM KOHONEN
#
# Entrada:
#       vector táctil 24D
#
# Salida:
#       espacio latente 2D
#       mapa 6 x 4
#
# ============================================================



# ==========================================================
# BLOQUE 3
# SOM KOHONEN COMPLETO
# MAPA LATENTE 6 x 4
# INPUT: 24 DIMENSIONES SENSORIALES
# OUTPUT: ESPACIO LATENTE 2D
# ==========================================================


class SOM:


    def __init__(
        self,
        rows=6,
        cols=4,
        input_dim=24
    ):


        self.rows = rows
        self.cols = cols
        self.input_dim = input_dim


        # ------------------------------------------
        # parámetros aprendizaje Kohonen
        # ------------------------------------------

        self.learning_rate = 0.35
        self.radius = 2.5

        self.step = 0



        # ------------------------------------------
        # pesos de neuronas
        # 6 x 4 neuronas
        # cada una con vector de 24 entradas
        # ------------------------------------------

        self.weights = (

            np.random.random(
                (
                    rows,
                    cols,
                    input_dim
                )
            )
            *
            0.1

        ).astype(
            np.float32
        )



        # ------------------------------------------
        # GRID LATENTE 2D
        # ------------------------------------------

        grid = []


        for x in range(rows):

            for y in range(cols):

                grid.append(
                    [
                        x,
                        y
                    ]
                )


        self.grid = np.array(
            grid,
            dtype=np.float32
        )



        print("--------------------------------")
        print("SOM KOHONEN READY")
        print("MAP:")
        print(
            rows,
            "x",
            cols
        )
        print(
            "LATENT SPACE: 24D -> 2D"
        )
        print("--------------------------------")




    # ------------------------------------------------
    # buscar neurona ganadora BMU
    # ------------------------------------------------


    def winner(
        self,
        x
    ):


        distances = np.zeros(
            (
                self.rows,
                self.cols
            ),
            dtype=np.float32
        )



        for i in range(
            self.rows
        ):

            for j in range(
                self.cols
            ):


                distances[i,j] = np.linalg.norm(

                    self.weights[i,j]
                    -
                    x

                )



        idx = np.unravel_index(

            np.argmin(
                distances
            ),

            distances.shape

        )


        bmu = (
            idx[0] *
            self.cols
            +
            idx[1]
        )


        error = distances[idx]


        return (
            bmu,
            float(error)
        )




    # ------------------------------------------------
    # aprendizaje Kohonen
    # ------------------------------------------------


    def update(
        self,
        x
    ):


        bmu, _ = self.winner(
            x
        )



        bx = (
            bmu //
            self.cols
        )

        by = (
            bmu %
            self.cols
        )



        # decaimiento

        lr = (
            self.learning_rate
            *
            np.exp(
                -self.step / 5000
            )
        )


        radius = max(

            0.5,

            self.radius
            *
            np.exp(
                -self.step / 5000
            )

        )



        # actualización vecindad

        for i in range(
            self.rows
        ):

            for j in range(
                self.cols
            ):


                distance_grid = math.sqrt(

                    (i-bx)**2
                    +
                    (j-by)**2

                )



                influence = np.exp(

                    -(
                        distance_grid**2
                    )
                    /
                    (
                        2 *
                        radius *
                        radius
                    )

                )



                self.weights[i,j] += (

                    lr *
                    influence *
                    (
                        x
                        -
                        self.weights[i,j]
                    )

                )



        self.step += 1




# ==========================================================
# CREAR SOM
# ==========================================================


som = SOM()


