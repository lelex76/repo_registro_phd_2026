def read_textile():


    vector = np.zeros(

        24,
        dtype=np.float32

    )


    left_touch = mpr_left.touched()

    right_touch = mpr_right.touched()



    for ch in range(12):


        if left_touch & (1 << ch):

            vector[ch] = 1.0




    for ch in range(12):


        if right_touch & (1 << ch):

            vector[ch+12] = 1.0



    return vector





# ==========================================================
# SUAVIZADO SENSORIAL
# ==========================================================


touch_memory = np.zeros(

    24,
    dtype=np.float32

)



def smooth_touch(raw):


    global touch_memory



    touch_memory = (

        0.80 * touch_memory

        +

        0.20 * raw

    )



    return touch_memory.copy()

# ==========================================================
# BLOQUE 3
#
# SOM KOHONEN
#
# INPUT:
#       24 dimensiones táctiles
#
# OUTPUT:
#       mapa latente 2D
#
# ==========================================================


class SOM:


    def __init__(self, rows=6, cols=4, input_dim=24):


        self.rows = rows
        self.cols = cols
        self.input_dim = input_dim


        # ------------------------------------------
        # parámetros Kohonen
        # ------------------------------------------

        self.learning_rate = 0.35
        self.radius = 2.5
        self.step = 0



        # ------------------------------------------
        # pesos neuronales
        # ------------------------------------------

        self.weights = (

            np.random.random(

                (
                    rows,
                    cols,
                    input_dim
                )

            )

            *

            0.1

        ).astype(

            np.float32

        )



        # ------------------------------------------
        # espacio latente 2D
        # ------------------------------------------

        grid = []


        for x in range(rows):

            for y in range(cols):

                grid.append(

                    [
                        x,
                        y
                    ]

                )


        self.grid = np.array(

            grid,

            dtype=np.float32

        )


        print("--------------------------------")
        print("SOM KOHONEN READY")
        print("MAP:")
        print(rows, "x", cols)
        print("LATENT SPACE: 24D -> 2D")
        print("--------------------------------")




    # ==================================================
    # BUSCAR BMU
    # ==================================================


    def winner(self, x):


        distances = np.zeros(

            (
                self.rows,
                self.cols
            ),

            dtype=np.float32

        )



        for i in range(self.rows):


            for j in range(self.cols):


                distances[i,j] = np.linalg.norm(

                    self.weights[i,j]

                    -

                    x

                )



        idx = np.unravel_index(

            np.argmin(distances),

            distances.shape

        )



        bmu = (

            idx[0]

            *

            self.cols

            +

            idx[1]

        )



        error = distances[idx]



        return (

            bmu,

            float(error)

        )





    # ==================================================
    # ACTUALIZACIÓN KOHONEN
    # ==================================================


    def update(self, x):


        bmu, _ = self.winner(x)



        bx = (

            bmu //

            self.cols

        )


        by = (

            bmu %

            self.cols

        )



        # aprendizaje decreciente

        lr = (

            self.learning_rate

            *

            np.exp(

                -self.step / 5000

            )

        )



        radius = max(

            0.5,

            self.radius

            *

            np.exp(

                -self.step / 5000

            )

        )



        # vecindad neuronal


        for i in range(self.rows):


            for j in range(self.cols):


                distance_grid = math.sqrt(

                    (i - bx)**2

                    +

                    (j - by)**2

                )



                influence = np.exp(

                    -(distance_grid**2)

                    /

                    (

                        2 *
                        radius *
                        radius

                    )

                )



                self.weights[i,j] += (

                    lr

                    *

                    influence

                    *

                    (

                        x

                        -

                        self.weights[i,j]

                    )

                )



        self.step += 1





# ==========================================================
# CREAR MAPA SOM
# ==========================================================


som = SOM()

# ==========================================================
# BLOQUE 4
# MOTOR GENERATIVO + MEMORIA TEXTIL
# ==========================================================


def main():


    print("--------------------------------")
    print("TmaqT LATENT GENERATIVE START")
    print("TEXTILE MEMORY + RESONANCE")
    print("--------------------------------")


    smooth = np.zeros(

        24,

        dtype=np.float32

    )



    global current_amp
    global gesture_memory



    current_amp = 0.0



    # iniciar campo FX

    play_fx_base()



    while True:



        # --------------------------------------------------
        # LECTURA SENSORIAL
        # --------------------------------------------------


        left_touch = mpr_left.touched()

        right_touch = mpr_right.touched()



        raw_left = np.array(

            [

                (left_touch >> i) & 1

                for i in range(12)

            ],

            dtype=np.float32

        )



        raw_right = np.array(

            [

                (right_touch >> i) & 1

                for i in range(12)

            ],

            dtype=np.float32

        )



        raw = np.concatenate(

            [

                raw_left,

                raw_right

            ]

        )




        # --------------------------------------------------
        # MEMORIA SENSORIAL
        # --------------------------------------------------


        smooth = (

            0.8 * smooth

            +

            0.2 * raw

        )



        latent_input = np.clip(

            smooth,

            0,

            1

        )



        active = np.where(

            raw > 0

        )[0]





        # --------------------------------------------------
        # SIN CONTACTO
        # mantiene resonancia
        # --------------------------------------------------


        if len(active) == 0:



            gesture_memory *= DECAY



            time.sleep(0.01)


            continue





        # --------------------------------------------------
        # MEMORIA TEXTIL
        #
        # gesto -> memoria -> resonancia
        # --------------------------------------------------



        gesture_memory *= DECAY



        gesture_memory += (

            latent_input

        )



        memory_energy = np.sum(

            gesture_memory

        )



        energy = (

            memory_energy

            *

            FEEDBACK

        )



        amp = np.clip(

            (energy / 12.0) ** 2.8,

            0.0,

            1.0

        )






        # --------------------------------------------------
        # SOM KOHONEN
        # --------------------------------------------------


        bmu, distance = som.winner(

            latent_input

        )



        som.update(

            latent_input

        )





        # coordenada mapa 6x4


        coord = som.grid[bmu]



        x_latent = coord[0]

        y_latent = coord[1]






        # --------------------------------------------------
        # LATENT SPACE -> AUDIO
        # --------------------------------------------------


        freq = (

            120

            +

            x_latent * 120

            +

            y_latent * 80

        )






        print(

            "TOUCH",

            active.tolist(),

            "BMU",

            bmu,

            "LATENT",

            round(float(x_latent),2),

            round(float(y_latent),2),

            "MEM",

            round(float(memory_energy),2),

            "FREQ",

            int(freq)

        )






        # --------------------------------------------------
        # SINTESIS TEXTIL
        # --------------------------------------------------


        play_synth(

            freq,

            amp

        )



        time.sleep(

            0.01

        )






# ==========================================================
# START
# ==========================================================


if __name__ == "__main__":


    main()


