import pygame
import math
import random



# ==========================================================
# CONFIG AUDIO
# ==========================================================

SAMPLE_RATE = 44100
BUFFER = 512


pygame.mixer.pre_init(
    SAMPLE_RATE,
    -16,
    1,
    BUFFER
)


pygame.init()


pygame.mixer.set_num_channels(
    8
)


# Canal gesto textil
audio_channel = pygame.mixer.Channel(0)


# Canal FX ambiente
fx_channel = pygame.mixer.Channel(1)



# ==========================================================
# MEMORIA DE FASE
# ==========================================================

phase = 0
fx_phase = 0



# ==========================================================
# MEMORIA TEXTIL / RESONANCIA
# ==========================================================

gesture_memory = np.zeros(
    24,
    dtype=np.float32
)


DECAY = 0.985
FEEDBACK = 0.35



# ==========================================================
# FX BASE
# ==========================================================
FX_FREQ = 28
FX_AMP = 0.06
# ==========================================================
# REPRODUCCI ^sN S ^mNTESIS TEXTIL
# ==========================================================


def play_synth(freq, amp):


    global audio_channel



    amp = float(

        np.clip(

            amp,
            0.0,
            1.0
        )

    )

    if amp < 0.01:

        audio_channel.set_volume(
            0
        )

        return


# ==========================================================
# OSCILADOR DIGITAL
# ==========================================================


def synth_buffer(freq, amp):


    global phase



    t = (
        np.arange(BUFFER)
        /
        SAMPLE_RATE
    )



    wave = np.sin(

        2 *
        np.pi *
        freq *
        t
        +
        phase

    )



    phase += (

        2 *
        np.pi *
        freq *
        BUFFER
        /
        SAMPLE_RATE

    )



    # subarmónico

    sub_wave = np.sin(

        2 *
        np.pi *
        (freq * 0.5)
        *
        t

    )



    # ruido orgánico

    noise = (

        np.random.rand(BUFFER)
        -
        0.5

    )



    # textura híbrida

    signal = (

        0.70 * wave

        +

        0.15 * sub_wave

        +

        0.15 * noise

    )



    signal *= amp



    signal = np.clip(

        signal,
        -1,
        1

    )



    return (

        signal * 32767

    ).astype(

        np.int16

    )





# ==========================================================
# REPRODUCCIÓN SÍNTESIS TEXTIL
# ==========================================================


def play_synth(freq, amp):


    global audio_channel



    amp = float(

        np.clip(

            amp,
            0.0,
            1.0

        )

    )



    if amp < 0.01:


        audio_channel.set_volume(
            0
        )

        return



    data  = synth_buffer(

        FX_FREQ, 
        FX_AMP

    )



    sound = pygame.mixer.Sound(

        buffer=data

    )



    audio_channel.play(

        sound,
        loops=-1

    )



    audio_channel.set_volume(

        amp

    )





